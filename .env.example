# Copy to /etc/surge/surge.env on the VPS and replace every placeholder.
# Do not commit the real file.

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=replace-with-a-long-random-value

RESEND_API_KEY=
NOTIFY_EMAIL=

ADMIN_USER=choose-a-unique-admin-user
ADMIN_PASS=choose-a-long-random-password

SURGE_RUNTIME_DIR=/var/lib/surge
SURGE_DATA_DIR=/opt/surge/current/data
SURGE_ARTIFACT_DIR=/var/lib/surge/artifacts
SURGE_ARTIFACTS_FILE=/var/lib/surge/artifacts.json
LOADOUT_API=http://127.0.0.1:8020/api/calculate
LOADOUT_DATA_DIR=/opt/surge/current/loadout_local/data

# Optional: set only if the rate notifier is deployed.
DISCORD_BOT_TOKEN=
