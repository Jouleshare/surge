[Unit]
Description=AMPD local Loadout calculation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=surge
Group=surge
WorkingDirectory=/opt/surge/current
EnvironmentFile=/etc/surge/surge.env
ExecStart=/opt/surge/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8020 --access-logfile - --error-logfile - loadout_local.app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
